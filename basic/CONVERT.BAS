10 REM CONVERT.BAS - UNIT CONVERTER
20 REM TEMPERATURE, LENGTH AND WEIGHT CONVERSIONS.
30 PRINT "UNIT CONVERTER"
40 PRINT "=============="
50 PRINT ""
60 PRINT "  1  TEMPERATURE  (CELSIUS / FAHRENHEIT)"
70 PRINT "  2  LENGTH       (KILOMETRES / MILES)"
80 PRINT "  3  WEIGHT       (KILOGRAMS / POUNDS)"
90 PRINT "  0  QUIT"
100 PRINT ""
110 INPUT "CHOOSE: "; C
120 IF C = 0 THEN 900
130 IF C = 1 THEN GOSUB 1000
140 IF C = 2 THEN GOSUB 2000
150 IF C = 3 THEN GOSUB 3000
160 GOTO 50
900 PRINT "GOODBYE."
910 END

1000 REM TEMPERATURE
1010 PRINT ""
1020 PRINT "  1  CELSIUS TO FAHRENHEIT"
1030 PRINT "  2  FAHRENHEIT TO CELSIUS"
1040 INPUT "  DIRECTION (1/2): "; D
1050 IF D = 1 THEN 1080
1060 IF D = 2 THEN 1100
1070 PRINT "  INVALID CHOICE.": RETURN
1080 INPUT "  CELSIUS: "; V
1090 PRINT "  "; V; " C  =  "; V * 9 / 5 + 32; " F"
1095 RETURN
1100 INPUT "  FAHRENHEIT: "; V
1110 PRINT "  "; V; " F  =  "; (V - 32) * 5 / 9; " C"
1120 RETURN

2000 REM LENGTH
2010 PRINT ""
2020 PRINT "  1  KILOMETRES TO MILES"
2030 PRINT "  2  MILES TO KILOMETRES"
2040 INPUT "  DIRECTION (1/2): "; D
2050 IF D = 1 THEN 2080
2060 IF D = 2 THEN 2100
2070 PRINT "  INVALID CHOICE.": RETURN
2080 INPUT "  KILOMETRES: "; V
2090 PRINT "  "; V; " KM  =  "; V * 0.621371; " MILES"
2095 RETURN
2100 INPUT "  MILES: "; V
2110 PRINT "  "; V; " MILES  =  "; V / 0.621371; " KM"
2120 RETURN

3000 REM WEIGHT
3010 PRINT ""
3020 PRINT "  1  KILOGRAMS TO POUNDS"
3030 PRINT "  2  POUNDS TO KILOGRAMS"
3040 INPUT "  DIRECTION (1/2): "; D
3050 IF D = 1 THEN 3080
3060 IF D = 2 THEN 3100
3070 PRINT "  INVALID CHOICE.": RETURN
3080 INPUT "  KILOGRAMS: "; V
3090 PRINT "  "; V; " KG  =  "; V * 2.20462; " LBS"
3095 RETURN
3100 INPUT "  POUNDS: "; V
3110 PRINT "  "; V; " LBS  =  "; V / 2.20462; " KG"
3120 RETURN
