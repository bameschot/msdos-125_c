10 REM QUIZ.BAS - MENTAL ARITHMETIC QUIZ
20 REM TESTS ADDITION, SUBTRACTION, MULTIPLICATION AND DIVISION.
30 PRINT "MATHS QUIZ"
40 PRINT "=========="
50 PRINT ""
60 INPUT "HOW MANY QUESTIONS (1-20)? "; N
70 IF N >= 1 THEN 90
80 N = 10
90 IF N <= 20 THEN 110
100 N = 20
110 PRINT ""
120 S = 0
130 FOR I = 1 TO N
140   O = INT(RND(1) * 4) + 1
150   A = INT(RND(1) * 12) + 1
160   B = INT(RND(1) * 12) + 1
170   IF O = 1 THEN GOSUB 1000
180   IF O = 2 THEN GOSUB 1100
190   IF O = 3 THEN GOSUB 1200
200   IF O = 4 THEN GOSUB 1300
210 NEXT I
220 PRINT ""
230 PRINT "QUIZ COMPLETE!"
240 PRINT "SCORE : "; S; " OUT OF "; N
250 P = INT(S * 100 / N)
260 PRINT "GRADE : "; P; "%"
270 PRINT ""
280 IF P >= 90 THEN PRINT "OUTSTANDING!"
290 IF P >= 70 AND P < 90 THEN PRINT "WELL DONE!"
300 IF P >= 50 AND P < 70 THEN PRINT "KEEP PRACTISING."
310 IF P < 50 THEN PRINT "BETTER LUCK NEXT TIME."
320 PRINT ""
330 INPUT "PLAY AGAIN (Y/N)? "; A$
340 IF A$ = "Y" THEN 50
350 IF A$ = "y" THEN 50
360 PRINT "GOODBYE."
370 END

1000 REM ADDITION: A + B = C
1010 C = A + B
1020 PRINT "  Q "; I; "/"; N; ":  "; A; " + "; B; " = ";
1030 INPUT ""; G
1040 IF G = C THEN 1060
1050 PRINT "  WRONG! ANSWER IS "; C: GOTO 1070
1060 PRINT "  CORRECT!": S = S + 1
1070 RETURN

1100 REM SUBTRACTION: A - B = C  (A >= B guaranteed)
1110 IF A >= B THEN 1130
1120 T = A: A = B: B = T
1130 C = A - B
1140 PRINT "  Q "; I; "/"; N; ":  "; A; " - "; B; " = ";
1150 INPUT ""; G
1160 IF G = C THEN 1180
1170 PRINT "  WRONG! ANSWER IS "; C: GOTO 1190
1180 PRINT "  CORRECT!": S = S + 1
1190 RETURN

1200 REM MULTIPLICATION: A * B = C
1210 C = A * B
1220 PRINT "  Q "; I; "/"; N; ":  "; A; " x "; B; " = ";
1230 INPUT ""; G
1240 IF G = C THEN 1260
1250 PRINT "  WRONG! ANSWER IS "; C: GOTO 1270
1260 PRINT "  CORRECT!": S = S + 1
1270 RETURN

1300 REM DIVISION: (A*B) / A = B  (always exact)
1310 C = A * B
1320 PRINT "  Q "; I; "/"; N; ":  "; C; " / "; A; " = ";
1330 INPUT ""; G
1340 IF G = B THEN 1360
1350 PRINT "  WRONG! ANSWER IS "; B: GOTO 1370
1360 PRINT "  CORRECT!": S = S + 1
1370 RETURN
