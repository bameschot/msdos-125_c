1 REM HAMURABI.BAS - GOVERN ANCIENT SUMERIA FOR 10 YEARS
2 REM ADAPTED FROM DAVID AHL'S CLASSIC BASIC GAME (1973)
3 REM
4 REM VARIABLES
5 REM Y=YEAR(1-10)  P=PEOPLE   S=GRAIN STORES  L=LAND(ACRES)
6 REM E=LAND PRICE  H=HARVEST/ACRE  I=RATS ATE  Q=STARVED
7 REM C=IMMIGRANTS  D=TOTAL DEAD    G=GRAIN FOR FOOD  F=FIELDS
8 REM A=ACRES DEAL  T=TEMP          N=TEMP
10 PRINT "HAMURABI"
11 PRINT "========"
12 PRINT "YOU ARE HAMURABI, RULER OF ANCIENT SUMERIA."
13 PRINT "GOVERN YOUR KINGDOM WISELY FOR 10 YEARS."
14 PRINT ""
15 PRINT "EACH PERSON NEEDS 20 BUSHELS OF GRAIN PER YEAR."
16 PRINT "ONE PERSON CAN TEND UP TO 10 ACRES OF CROPS."
17 PRINT "IT COSTS 0.5 BUSHELS OF SEED TO PLANT ONE ACRE."
18 PRINT ""

20 Y = 1
21 P = 100
22 S = 2800
23 L = 1000
24 D = 0
25 Q = 0
26 C = 5
27 H = 3
28 I = 200

100 REM ============================
101 REM YEAR SUMMARY
102 REM ============================
110 PRINT ""
111 PRINT "--- YEAR "; Y; "OF 10 ---"
112 PRINT ""
120 IF Q = 0 THEN 140
121 PRINT Q; " PEOPLE STARVED AND DIED LAST YEAR."
122 D = D + Q
123 GOTO 150
140 PRINT "NO ONE STARVED LAST YEAR."
150 P = P + C - Q
155 IF P < 1 THEN P = 1
160 PRINT C; " PEOPLE CAME TO THE CITY."
170 PRINT ""
180 PRINT "  POPULATION  :"; P; " PEOPLE"
190 PRINT "  LAND        :"; L; " ACRES"
200 PRINT "  GRAIN STORES:"; S; " BUSHELS"
205 PRINT "  LAST HARVEST:"; H; " BUSHELS/ACRE"
210 PRINT "  RATS ATE    :"; I; " BUSHELS"
215 E = INT(RND(1) * 10) + 17
220 PRINT "  LAND PRICE  :"; E; " BUSHELS/ACRE"

300 REM ============================
301 REM BUY OR SELL LAND
302 REM ============================
310 PRINT ""
315 PRINT "LAND TRADING"
316 PRINT "  POSITIVE NUMBER = BUY ACRES"
317 PRINT "  NEGATIVE NUMBER = SELL ACRES"
318 PRINT "  ZERO            = NO TRADE"
320 INPUT "  ACRES: "; A
325 IF A >= 0 THEN 380
330 REM SELLING: A is negative, T = acres to sell
335 T = -A
340 IF T <= L THEN 360
345 PRINT "  YOU ONLY HAVE "; L; " ACRES TO SELL."
350 GOTO 320
360 S = S + T * E
365 L = L - T
370 GOTO 430
380 IF A = 0 THEN 430
385 IF A * E <= S THEN 420
390 PRINT "  BUYING "; A; " ACRES COSTS "; A * E; " BUSHELS."
395 PRINT "  YOU ONLY HAVE "; S; " BUSHELS."
400 GOTO 320
420 S = S - A * E
425 L = L + A

430 REM ============================
431 REM GRAIN FOR FOOD
432 REM ============================
440 PRINT ""
445 PRINT "FEEDING YOUR PEOPLE ("; P; " NEED "; P * 20; " BUSHELS)"
450 INPUT "  BUSHELS FOR FOOD: "; G
455 IF G >= 0 THEN 470
460 GOTO 450
470 IF G <= S THEN 490
475 PRINT "  YOU ONLY HAVE "; S; " BUSHELS. TRY AGAIN."
480 GOTO 450
490 S = S - G

500 REM ============================
501 REM PLANT CROPS
502 REM ============================
510 PRINT ""
515 T = INT(S * 2)
520 IF T > L THEN T = L
525 N = P * 10
530 IF N < T THEN T = N
535 PRINT "PLANTING (MAX "; T; " ACRES)"
540 PRINT "  "; S; " BUSHELS SEED = UP TO "; INT(S * 2); " ACRES"
545 PRINT "  "; P; " PEOPLE = UP TO "; P * 10; " ACRES"
550 PRINT "  "; L; " ACRES OWNED"
560 INPUT "  ACRES TO PLANT: "; F
565 IF F >= 0 THEN 580
570 GOTO 560
580 IF F <= L THEN 600
585 PRINT "  YOU ONLY OWN "; L; " ACRES."
590 GOTO 560
600 IF F <= S * 2 THEN 620
605 PRINT "  NOT ENOUGH SEED. NEED "; INT(F / 2 + 1); " BUSHELS."
610 GOTO 560
620 IF F <= P * 10 THEN 640
625 PRINT "  NOT ENOUGH PEOPLE TO TEND "; F; " ACRES."
630 GOTO 560
640 S = S - INT(F / 2)

700 REM ============================
701 REM HARVEST AND EVENTS
702 REM ============================
710 H = INT(RND(1) * 10) + 1
720 PRINT ""
730 PRINT "--- HARVEST REPORT ---"
740 PRINT "YIELD: "; H; " BUSHELS PER ACRE"
745 PRINT "TOTAL HARVEST: "; H * F; " BUSHELS FROM "; F; " ACRES."
750 S = S + H * F

760 REM RATS
770 I = 0
780 IF RND(1) >= 0.4 THEN 810
790 I = INT(S / (INT(RND(1) * 5) + 2))
800 PRINT "RATS INVADED AND DESTROYED "; I; " BUSHELS!"
805 S = S - I

810 REM PLAGUE
815 IF RND(1) >= 0.15 THEN 840
820 PRINT "A TERRIBLE PLAGUE STRIKES THE CITY!"
825 P = INT(P / 2)
830 PRINT "HALF THE POPULATION DIES. ONLY "; P; " SURVIVE."

840 REM STARVATION
850 T = INT(G / 20)
855 IF T > P THEN T = P
860 Q = P - T
865 IF Q <= 0 THEN 920
870 PRINT ""
875 PRINT Q; " PEOPLE HAVE STARVED."
880 IF Q < INT(P * 0.45) THEN 920
885 PRINT ""
890 PRINT "YOU HAVE STARVED "; Q; " OF "; P; " PEOPLE IN ONE YEAR!"
895 PRINT "THE CITIZENS REVOLT AND DRIVE YOU FROM THE THRONE!"
900 GOTO 9000

920 REM IMMIGRATION
925 C = INT((20 * L + S) / (P * 100) + 1)
930 IF C < 0 THEN C = 0
935 IF C > 50 THEN C = 50
940 Y = Y + 1
945 IF Y <= 10 THEN 100

1000 REM ============================
1001 REM FINAL REPORT
1002 REM ============================
1010 D = D + Q
1015 PRINT ""
1016 PRINT "============================"
1017 PRINT "YOUR 10-YEAR TERM IS OVER!"
1018 PRINT "============================"
1020 PRINT ""
1025 PRINT "TOTAL DEATHS BY STARVATION: "; D
1030 T = INT(L / P)
1035 PRINT "FINAL LAND PER PERSON     : "; T; " ACRES"
1040 PRINT ""
1050 IF D > INT(P * 0.33) THEN 1150
1060 IF T < 7 THEN 1120
1070 PRINT "AN OUTSTANDING PERFORMANCE!"
1075 PRINT "SUMERIA FLOURISHES UNDER YOUR WISE LEADERSHIP."
1080 PRINT "THE PEOPLE HAVE DECLARED YOU KING FOR LIFE!"
1085 GOTO 9000
1120 PRINT "A SATISFACTORY PERFORMANCE."
1125 PRINT "THE PEOPLE ARE CONTENT, THOUGH NOT OVERJOYED."
1130 GOTO 9000
1150 PRINT "YOUR MISMANAGEMENT HAS CAUSED WIDESPREAD SUFFERING."
1155 PRINT "THE HIGH COUNCIL HAS VOTED YOU OUT OF OFFICE."
1160 PRINT "HISTORY WILL NOT REMEMBER YOU FONDLY."

9000 PRINT ""
9010 PRINT "GAME OVER."
9020 END
