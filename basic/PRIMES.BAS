10 REM PRIMES.BAS - LIST ALL PRIME NUMBERS UP TO N
20 REM USES TRIAL DIVISION BY ODD NUMBERS UP TO SQR(N).
30 PRINT "PRIME NUMBERS"
40 PRINT "============="
50 PRINT ""
60 INPUT "LIST PRIMES UP TO (MAX 500): "; N
70 IF N >= 2 THEN 100
80 PRINT "PLEASE ENTER A NUMBER BETWEEN 2 AND 500."
90 GOTO 50
100 IF N <= 500 THEN 120
110 N = 500
120 PRINT ""
130 PRINT "PRIMES UP TO "; N; ":"
140 PRINT ""
150 C = 0
160 PRINT "2 ";
170 C = 1
180 FOR K = 3 TO N STEP 2
190   P = 1
195   IF INT(SQR(K)) < 3 THEN 230
200   FOR J = 3 TO INT(SQR(K)) STEP 2
210     IF K / J = INT(K / J) THEN P = 0
220   NEXT J
230   IF P = 0 THEN 260
240   PRINT K; " ";
250   C = C + 1
260 NEXT K
270 PRINT ""
280 PRINT ""
290 PRINT C; " PRIMES FOUND."
300 PRINT ""
310 INPUT "TRY ANOTHER LIMIT (Y/N)? "; A$
320 IF A$ = "Y" THEN 50
330 IF A$ = "y" THEN 50
340 END
