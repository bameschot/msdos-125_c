10 REM LOAN.BAS - MONTHLY LOAN PAYMENT CALCULATOR
20 REM STANDARD AMORTISATION FORMULA: M = P*r*(1+r)^n / ((1+r)^n - 1)
30 PRINT "LOAN PAYMENT CALCULATOR"
40 PRINT "======================="
50 PRINT ""
60 INPUT "LOAN AMOUNT ($): "; P
70 IF P > 0 THEN 90
80 PRINT "LOAN AMOUNT MUST BE GREATER THAN ZERO.": GOTO 50
90 INPUT "ANNUAL INTEREST RATE (%): "; R
100 IF R >= 0 THEN 120
110 PRINT "INTEREST RATE CANNOT BE NEGATIVE.": GOTO 90
120 INPUT "LOAN TERM (MONTHS): "; N
130 IF N >= 1 THEN 150
140 PRINT "TERM MUST BE AT LEAST 1 MONTH.": GOTO 120
150 PRINT ""
160 IF R = 0 THEN 240
170 REM STANDARD AMORTISATION
180 R = R / 1200
190 T = (1 + R) ^ N
200 M = P * R * T / (T - 1)
210 PRINT "MONTHLY PAYMENT : $"; M
220 PRINT "TOTAL PAID      : $"; M * N
230 GOTO 260
240 REM ZERO INTEREST
250 M = P / N
255 PRINT "MONTHLY PAYMENT : $"; M
257 PRINT "TOTAL PAID      : $"; P
260 PRINT "TOTAL INTEREST  : $"; M * N - P
270 PRINT ""
280 INPUT "CALCULATE ANOTHER (Y/N)? "; A$
290 IF A$ = "Y" THEN 50
300 IF A$ = "y" THEN 50
310 PRINT "GOODBYE."
320 END
