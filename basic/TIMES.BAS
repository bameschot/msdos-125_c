10 REM TIMES.BAS - MULTIPLICATION TABLES
20 REM PRINTS THE COMPLETE TIMES TABLE FOR ANY NUMBER.
30 PRINT "MULTIPLICATION TABLES"
40 PRINT "====================="
50 PRINT ""
60 INPUT "ENTER A NUMBER (0 TO QUIT): "; N
70 IF N = 0 THEN 200
80 IF N > 0 THEN 100
90 GOTO 50
100 PRINT ""
110 PRINT "--- TIMES TABLE FOR "; N; "---"
120 PRINT ""
130 FOR I = 1 TO 12
140   PRINT "  "; N; " x "; I; " = "; N * I
150 NEXT I
160 PRINT ""
170 GOTO 50
200 PRINT "GOODBYE."
210 END
