10 REM CALC.BAS - 4-FUNCTION CALCULATOR WITH MEMORY
20 REM SUPPORTS: + - * / S(QRT) MR(ECALL) MS(TORE) Q(UIT)
30 PRINT "CALCULATOR"
40 PRINT "=========="
50 PRINT ""
60 PRINT "OPERATIONS: + - * /"
70 PRINT "SPECIALS  : S=SQRT  MR=RECALL MEMORY  MS=STORE TO MEMORY"
80 PRINT "            Q=QUIT"
90 M = 0
100 PRINT ""
110 INPUT "FIRST NUMBER : "; A
120 INPUT "OPERATION    : "; O$
130 IF O$ = "Q" THEN 700
135 IF O$ = "q" THEN 700
140 IF O$ <> "MR" THEN 160
145 PRINT "MEMORY = "; M
150 GOTO 100
160 IF O$ <> "MS" THEN 185
165 M = A
170 PRINT "STORED "; A; " TO MEMORY."
175 GOTO 100
185 IF O$ <> "S" THEN 210
190 PRINT "SQRT("; A; ") = "; SQR(ABS(A))
200 GOTO 100
210 INPUT "SECOND NUMBER: "; B
220 IF O$ <> "+" THEN 240
225 PRINT "RESULT = "; A + B
230 GOTO 100
240 IF O$ <> "-" THEN 260
245 PRINT "RESULT = "; A - B
250 GOTO 100
260 IF O$ <> "*" THEN 280
265 PRINT "RESULT = "; A * B
270 GOTO 100
280 IF O$ <> "/" THEN 320
285 IF B <> 0 THEN 305
290 PRINT "ERROR: DIVISION BY ZERO"
295 GOTO 100
305 PRINT "RESULT = "; A / B
310 GOTO 100
320 PRINT "UNKNOWN OPERATION: "; O$
325 GOTO 100
700 PRINT "GOODBYE."
710 END
