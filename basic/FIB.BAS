10 REM FIB.BAS - FIBONACCI SEQUENCE
20 REM DISPLAYS THE FIRST N FIBONACCI NUMBERS.
30 REM F(1)=0  F(2)=1  F(N)=F(N-1)+F(N-2)
40 PRINT "FIBONACCI SEQUENCE"
50 PRINT "=================="
60 PRINT ""
70 INPUT "HOW MANY TERMS TO SHOW (1-30): "; N
80 IF N >= 1 THEN 100
85 PRINT "PLEASE ENTER AT LEAST 1."
90 GOTO 60
100 IF N <= 30 THEN 120
105 PRINT "PLEASE ENTER 30 OR FEWER."
110 GOTO 60
120 PRINT ""
130 A = 0
140 B = 1
150 FOR I = 1 TO N
160   PRINT "F("; I; ") = "; A
170   C = A + B
180   A = B
190   B = C
200 NEXT I
210 PRINT ""
220 INPUT "AGAIN (Y/N)? "; A$
230 IF A$ = "Y" THEN 60
240 IF A$ = "y" THEN 60
250 END
