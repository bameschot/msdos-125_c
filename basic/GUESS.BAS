10 REM GUESS.BAS - NUMBER GUESSING GAME
20 REM THINK OF A NUMBER BETWEEN 1 AND 100 AND SEE HOW
30 REM QUICKLY THE PLAYER CAN FIND IT.
40 PRINT "GUESS THE NUMBER"
50 PRINT "================"
60 PRINT "I AM THINKING OF A NUMBER BETWEEN 1 AND 100."
70 PRINT "CAN YOU GUESS IT?"
80 S = INT(RND(1) * 100) + 1
90 T = 0
100 PRINT ""
110 INPUT "YOUR GUESS: "; G
120 T = T + 1
130 IF G = S THEN 200
140 IF G < S THEN PRINT "TOO LOW  - GUESS HIGHER."
150 IF G > S THEN PRINT "TOO HIGH - GUESS LOWER."
160 GOTO 100
200 PRINT "CORRECT! YOU FOUND "; S; " IN "; T; " GUESSES."
210 IF T <= 5 THEN PRINT "EXCELLENT GUESSING!"
220 IF T > 5 AND T <= 8 THEN PRINT "PRETTY GOOD."
230 IF T > 8 THEN PRINT "KEEP PRACTISING!"
240 PRINT ""
250 INPUT "PLAY AGAIN (Y/N)? "; A$
260 IF A$ = "Y" THEN 80
270 IF A$ = "y" THEN 80
280 PRINT "THANKS FOR PLAYING!"
290 END
