10 REM STATS.BAS - DESCRIPTIVE STATISTICS CALCULATOR
20 REM ENTER NUMBERS ONE AT A TIME. ENTER 0 TO FINISH.
30 REM NOTE: ZERO CANNOT BE USED AS A DATA VALUE.
40 PRINT "STATISTICS CALCULATOR"
50 PRINT "====================="
60 PRINT ""
70 PRINT "ENTER NUMBERS ONE AT A TIME."
80 PRINT "ENTER 0 WHEN DONE (ZERO IS NOT INCLUDED IN THE DATA)."
90 PRINT ""
100 N = 0
110 S = 0
120 Q = 0
130 M = 0
140 X = 0
150 INPUT "NUMBER: "; V
160 IF V = 0 THEN 350
170 N = N + 1
180 S = S + V
190 Q = Q + V * V
200 IF N > 1 THEN 230
210 M = V
220 X = V
230 IF V < M THEN M = V
240 IF V > X THEN X = V
250 GOTO 150
350 IF N >= 1 THEN 380
360 PRINT "NO DATA ENTERED."
370 GOTO 60
380 PRINT ""
390 PRINT "--- RESULTS ("; N; " VALUES) ---"
400 PRINT ""
410 PRINT "SUM    : "; S
420 A = S / N
430 PRINT "MEAN   : "; A
440 PRINT "MIN    : "; M
450 PRINT "MAX    : "; X
460 PRINT "RANGE  : "; X - M
470 IF N < 2 THEN 520
480 REM SAMPLE VARIANCE = (SUM_SQ - N*MEAN^2) / (N-1)
490 W = (Q - N * A * A) / (N - 1)
500 PRINT "STD DEV: "; SQR(ABS(W))
510 GOTO 530
520 PRINT "STD DEV: N/A (NEED AT LEAST 2 VALUES)"
530 PRINT ""
540 INPUT "CALCULATE AGAIN (Y/N)? "; A$
550 IF A$ = "Y" THEN 60
560 IF A$ = "y" THEN 60
570 PRINT "GOODBYE."
580 END
